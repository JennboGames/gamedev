# Copy to .env and adjust. .env is gitignored.

# --- PostgreSQL emulator (docker-compose) ---
POSTGRES_USER=pebble
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=foundationdb

# --- Azure Functions environment marker ---
# Exactly "Development" selects Azurite + local PostgreSQL. Any other or missing value selects
# managed-identity clients and fails startup when the Azure settings below are absent.
AZURE_FUNCTIONS_ENVIRONMENT=Development

# --- Local (Development only) ---
# Blob Storage emulator (Azurite)
STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
# Local PostgreSQL; keep in sync with POSTGRES_* above
DATABASE_URL=postgresql://pebble:change-me-local@localhost:5432/foundationdb

# --- Production (managed identity, no keys) ---
# Blob Storage account name; endpoint is https://<account>.blob.core.windows.net
AZURE_STORAGE_ACCOUNT=
# Azure Database for PostgreSQL Flexible Server (Entra auth)
AZURE_POSTGRES_HOST=
AZURE_POSTGRES_DATABASE=foundationdb
# Entra principal name that the managed identity maps to in PostgreSQL
AZURE_POSTGRES_USER=

# --- Amazon Product Advertising API 5.0 (external, no emulator) ---
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PARTNER_TAG=
AMAZON_PAAPI_HOST=webservices.amazon.com
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_MARKETPLACE=www.amazon.com

# --- Tuning (optional) ---
MAX_SHADES_PER_PRODUCT=60
EXTRACTION_WORKERS=8
LOG_LEVEL=INFO
